{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Voice",
  "version": "0.1.1",
  "identifier": "com.studiointhebox.myvoice",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "My Voice",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
